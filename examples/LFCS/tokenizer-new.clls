proc isDigit(r:digit;c:~lstring) {
    if (c >= "0") and (c <= "9" ) {
        affine r; #Digit r; let! r (ord(c)-ord("0"))
    } else {
        affine r; #None r; close r
    }
};;

// C-style
(r:digit) isDigit(c:lstring) {
    if (c >= "0") and (c <= "9" ) {
        fwd r affine #Digit (ord(c)-ord("0"));
    } else {
        fwd r #None close
    }
}


