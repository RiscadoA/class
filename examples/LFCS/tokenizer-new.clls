type digit {
    affine
    case of {
        |#Digit: !lint
        |#None : close
    }
};;

type alpha {
    affine
    case of {
        |#Alpha: !lstring
        |#None : close
    }
};;

proc isSpace(r:lbool;c:~lstring) {
    let r (c == "\n" or (c == "\r" or (c == " " or c == "\t")))
};;

proc isDigit(r:digit;c:~lstring) {
    if (c >= "0") and (c <= "9" ) {
        affine r; #Digit r; let! r (ord(c)-ord("0"))
    } else {
        affine r; #None r; close r
    }
};;

proc isAlpha(r:alpha;c:~lstring) {
    if (c >= "a") and (c <= "z" ) {
        affine r; #Alpha r; let! r c
    } else {
        affine r; #None r; close r
    }
};;

type token {
    affine
    case of {
        | #Id: !lstring
        | #Num: !lint
        | #PlusTok: close
        | #MulTok: close
        | #Lpar: close
        | #Rpar: close
        | #LamTok : close
        | #Error: close
    }
};;

proc print_tok(tok:~token)
{
    case tok of {
        | #Id: println("Id('"+tok+"')"); ()
        | #Num: println("Num("+tok+")"); ()
        | #LamTok: println("Tok(LAM)"); wait tok; ()
        | #PlusTok: println("Tok(+)"); wait tok; ()
        | #MulTok: println("Tok(*)"); wait tok; ()
        | #Lpar: println("Tok(LPAR)"); wait tok; ()
        | #Rpar: println("Tok(RPAR)"); wait tok; ()
        | #Error: println("Error()"); wait tok; ()
    }
};;

proc free_tok(tok:~token)
{
    case tok of {
        | #Id:  ()
        | #Num:  ()
        | #PlusTok, #MulTok, #Lpar, #Rpar, #LamTok, #Error: wait tok; ()
    }
};;

proc unsafe_rec scan_token_aux(
        tok:pair token;!lstring; // returns token and lookahead char
        c:~lstring, // last char read
        acc:~lstring, // current token image
        v:~lint, // current int val (if tokenizing num)
        stat:~lint) { // automaton state
    if (stat==0) { // automaton initial state
        if c == "(" {
            letc c:!lstring { scanc(c) };
            tok <- {t.affine t; #Lpar t; close t};     
            let! tok c       
        } else if c == ")" {
            letc c:!lstring { scanc(c) };
            tok <- {t.affine t; #Rpar t; close t};     
            let! tok c       
        } else if c == "+" {
            letc c:!lstring { scanc(c) };
            tok <- {t.affine t; #PlusTok t; close t};     
            let! tok c       
        } else if c == "*" {
            letc c:!lstring { scanc(c) };
            tok <- {t.affine t; #MulTok t; close t};     
            let! tok c       
        } else {
            letc s:lbool { isSpace(s;c)};
            if (s) { 
                letc cn:!lstring { scanc(cn) };
                scan_token_aux(tok;cn,acc,v,0)
            } else {
                letc r:digit { isDigit(r;c) };
                letc cx:!lstring { scanc(cx) };
                case r of {
                    | #Digit : scan_token_aux(tok;cx,acc,r,1) 
                    | #None:  
                        wait r;  
                        letc a:alpha { isAlpha(a;c) };
                        case a of {
                            | #Alpha: scan_token_aux(tok;cx,acc+a,0,2) 
                            | #None:
                                wait a;
                                tok <- {t. affine t; #Error t; close t};     
                                let! tok "EOF!"  
                        }                         
                }
            }
        }            
    } else if stat==1 {
        letc r:digit { isDigit(r;c) };
        letc cy:!lstring { scanc(cy) };
        case r of {
            | #Digit : scan_token_aux(tok; cy, acc, v*10+r, 1) 
            | #None:    
                wait r;  
                tok <- {t. affine t; #Num t; let! t v};     
                let! tok cy       
        }
    } else { // stat = 2
            letc a:alpha { isAlpha(a;c) };
            letc cx:!lstring { scanc(cx) };
            case a of {
                | #Alpha: scan_token_aux(tok;cx,acc+a,0,2) 
                | #None:
                    wait a;
                    if acc == "lambda" {
                        tok <- {t. affine t; #LamTok t; close t};     
                        let! tok cx   
                    } else {
                    tok <- {t. affine t; #Id t; let! t acc};     
                    let! tok cx   
                    }    
            }
    }
};;

proc scan_token(tok: send token;!lstring;c:~lstring) {
    scan_token_aux(tok;c,"",0,0)
};;

proc init_token(tok: send token;!lstring) {
    letc c:!lstring { scanc(c) };
    ?c;
    scan_token_aux(tok;c,"",0,0)
};;

proc unsafe_rec gettok(t0:~send token;!lstring)
{
    t0 -> a;
    if (t0 == "EOF!") {
        print_tok(a)
    } else {
        print_tok(a);
        letc t1: send token;!lstring { scan_token(t1;t0) };
        gettok(t1)
    }
};;

type rec tokStream {
    affine send token;tokStream
};;

proc unsafe_rec readTokensAux(last:~send token;!lstring,tout:tokStream)
{
        last -> tok;
        affine tout;
        tout <- tok;
        letc t1: send token;!lstring { scan_token(t1;last) };
        readTokensAux(t1,tout)
};;

proc readTokens(tout:tokStream)
{
    letc t0: send token;!lstring { init_token(t0) };
    readTokensAux(t0,tout)
};;

proc main1()
{
    letc t0: send token;!lstring { init_token(t0) };
    gettok(t0)
};;

type rec asTree {
    !
    case of {
        | #Num: !lint
        | #Mul:  pair asTree; asTree
        | #Plus: pair asTree; asTree
        | #App:  pair asTree; asTree
        | #Lam:  pair !lstring; asTree
        | #Id : !lstring
    }
};;

type rec value {
    !
    case of {
        | #None: close
        | #Num: !lint
        | #Clos: pair !lstring; pair env; asTree
    }
} and env { 
    !
    case of {
        | #Empty: close
        | #Entry: pair !lstring; pair value; env
    }
};;

type eenv {
    case of {
            | #Empty: close
            | #Entry: pair !lstring; pair value; env
        }    
};;

type venv {
    pair env; value
};;

proc print_val(val:~value){
    ?val;
    copy val(v);
    case v of {
        | #None: println("Undefined"); wait v;()
        | #Num: println(v);()
        | #Clos: v -> id; v -> env; unfold env; unfold v; ()
    }

};;

proc mk_Empty(ctx:env) {
    !ctx (e); #Empty e; close e
};;

proc mk_Num(n:~!lint,v:value)
{
    !v(n0);
    #Num n0; 
    let! n0 n
};;

proc mk_None(v:value)
{
    !v(n0);
    #None n0; 
    close n0
};;

proc mk_Clos(id:~!lstring,ast:~asTree,v:value;ctx:~eenv)
{
    unfold ast;
    ?ast;
    !v(n0);
    #Clos n0; 
    n0 <- id;
    n0 <- {s. fwd! s ctx};
    fwd! n0 ast 
};;

proc drop_Clos(c:~pair !lstring; pair env; asTree)
{
    recv c(s);
    recv c(e);
    unfold c;
    unfold e;
    ()
};;

proc unsafe_rec evaltree(ast:~asTree,v:value;ctx:~eenv) {
    ?ast;
    copy ast(t);
    case t of {
        | #App: t -> lhs;
                 letc v0:value { evaltree(lhs,v0;ctx) };
                 letc v1:value { evaltree(t,v1;ctx) };
                 unfold v0;
                 copy v0(v00);
                 case v00 of {
                    | #Clos: 
                            v00 -> id0;
                            v00 -> ctxe;
                            unfold ctxe;
                            ?ctxe;
                            unfold v1;
                            ?v1;
                            letc nenc:env {   
                                            !nenc(e);
                                            #Entry e;
                                            e <- id0;
                                            e <- v1;
                                            letc ctxel:env {
                                                unfold ctxel;
                                                !ctxel(ee0);
                                                copy ctxe(ee1);
                                                fwd ee1 ee0
                                             };
                                            fwd ctxel e
                                            };
                            unfold nenc;
                            ?nenc;
                            letc v2:value {
                                evaltree(v00,v2; nenc)
                                };
                            fwd v2 v
                    | #Num : ?v00; fwd v1 v
                    | #None :  wait v00; fwd v1 v
                 }

        | #Lam:  t->id;
                 mk_Clos(id,t,v;ctx)
        | #Num: mk_Num(t,v)
        | #Id: mk_Num(0,v)
        | #Plus: t -> lhs;
                 letc v0:value { evaltree(lhs,v0;ctx) };
                 letc v1:value { evaltree(t,v1;ctx) };
                 unfold v0;
                 unfold v1;
                 copy v0(n0);
                 case n0 of {
                    | #Num: 
                        copy v1(n1);
                        case n1 of {
                              | #Num : mk_Num(n0+n1,v)
                              | #Clos: drop_Clos(n1); mk_None(v)
                              | #None: wait n1; mk_None(v)
                            }
                    | #Clos: ?v1; drop_Clos(n0); mk_None(v)
                    | #None: wait n0; mk_None(v)
                 }
        | #Mul:  t -> lhs;
                 letc v0:value { evaltree(lhs,v0;ctx) };
                 letc v1:value { evaltree(t,v1;ctx) };
                 unfold v0;
                 unfold v1;
                 copy v0(n0);
                 case n0 of {
                    | #Num: 
                        copy v1(n1);
                        case n1 of {
                              | #Num : mk_Num(n0*n1,v)
                              | #Clos: drop_Clos(n1); mk_None(v)
                              | #None: wait n1; mk_None(v)
                            }
                    | #Clos: ?v1; drop_Clos(n0); mk_None(v)
                    | #None: wait n0; mk_None(v)
                 }
    }
};;

// returns AST and remainder of token stream (#Some) or closes (#None)
type OptionAST {
    case of {
        | #Some: pair asTree; tokStream
        | #None: close
    }
};;

proc pushfollow(tok:~token, ast0:~asTree,ast:OptionAST,cont1:~tokStream) {
    #Some ast; ast <- ast0;
    unfold cont1;
    affine ast;
    ast <- tok;
    fwd cont1 ast
};;

proc abort(ast: OptionAST, toks:~tokStream)
{
    #None ast; close ast; discard toks
};;

proc unsafe_rec expr(tokens: ~tokStream, ast: OptionAST) {
    letc cont1:OptionAST { term(tokens,cont1) };
    case cont1 of {
        | #None:
            wait cont1; #None ast; close ast
        | #Some:
            cont1 -> ast0;
            cont1 -> tok;
            case tok of {
                | #PlusTok:
                    wait tok;
                    letc cont2:OptionAST { expr(cont1,cont2) };
                    case cont2 of {
                        | #None: wait cont2; unfold ast0; #None ast; close ast
                        | #Some:
                            cont2 -> ast1;
                            unfold ast1;
                            ?ast1;
                            unfold ast0;
                            letc t:asTree {
                                    unfold t;
                                    !t(astplus);
                                    #Plus astplus; 
                                    astplus <- ast0; fwd! astplus ast1};
                            #Some ast; ast <- t; fwd cont2 ast
                    }
                | #Id, #Num: unfold ast0; abort(ast,cont1)
                | #Rpar: 
                    wait tok; 
                    letc pt:token { affine pt; #Rpar pt; close pt};
                    pushfollow(pt, ast0, ast, cont1)

                | #Error: 
                    wait tok; #Some ast; ast <- ast0; fwd cont1 ast
                | #MulTok,#LamTok,#Lpar: wait tok; unfold ast0; abort(ast,cont1)
                }
    }
} and term(tokens: ~tokStream, ast: OptionAST) {
    letc cont1:OptionAST { factor(tokens,cont1) };
    case cont1 of {
        | #None:
            wait cont1; #None ast; close ast
        | #Some:
            cont1 -> ast0;
            cont1 -> tok;
            case tok of {
                | #MulTok:
                    wait tok;
                    letc cont2:OptionAST { expr(cont1,cont2) };
                    case cont2 of {
                        | #None: wait cont2; unfold ast0; #None ast; close ast
                        | #Some:
                            cont2 -> ast1;
                            unfold ast1;
                            unfold ast0;
                            letc t:asTree {
                                    ! t (astmul);
                                    #Mul astmul; 
                                    astmul <- ast0; fwd!  astmul ast1};
                            #Some ast; ast <- t; fwd cont2 ast
                    }

                | #Id, #Num: unfold ast0 ; abort(ast,cont1)

                | #PlusTok: 
                    wait tok; 
                    letc pt:token { affine pt; #PlusTok pt; close pt};
                    pushfollow(pt, ast0, ast, cont1)

                | #Lpar: 
                    wait tok;
                    letc cont2:OptionAST { expr(cont1,cont2) };
                    case cont2 of {
                        | #None: wait cont2; unfold ast0; #None ast; close ast
                        | #Some:
                            cont2 -> ast1;
                            cont2 -> tok2;
                            case tok2 of {
                            | #Rpar: 
                                wait tok2; 
                                unfold ast1;
                                unfold ast0;
                                ?ast1;
                                letc t:asTree {
                                        !t(astapp);
                                        #App astapp; 
                                        astapp <- ast0; fwd! astapp ast1};
                                #Some ast; ast <- t; fwd cont2 ast

                            | #Id, #Num: unfold ast1; unfold ast0; abort(ast,cont2)
                            | #PlusTok,#MulTok,#Lpar,#LamTok,
                                #Error: wait tok2; unfold ast1; 
                                    unfold ast0; abort(ast,cont2)
                            }
                    }

                | #LamTok: wait tok; unfold ast0; abort(ast,cont1)

                | #Rpar: 
                    wait tok; 
                    letc pt:token { affine pt; #Rpar pt; close pt};
                    pushfollow(pt, ast0, ast, cont1)

                | #Error: 
                    wait tok; #Some ast; ast <- ast0; fwd cont1 ast
                }
    }
} and factor(tokens: ~tokStream, ast: OptionAST) {
    tokens -> tok1;
    case tok1 of {
    | #Lpar: 
        wait tok1;
        letc cont2 : OptionAST { expr(tokens,cont2) };
        case cont2 of {
            | #None : wait cont2; #None ast; close ast
            | #Some :
                cont2 -> ast1;
                cont2 -> tok2;
                case tok2 of {
                    | #Rpar: wait tok2; #Some ast; ast <- ast1; fwd cont2 ast     
                    | #Id, #Num: unfold ast1; abort(ast,cont2)
                    | #PlusTok,#MulTok,#Lpar,#LamTok,
                        #Error: wait tok2; unfold ast1; abort(ast,cont2)
                } 
        }
    | #Rpar: wait tok1;  abort(ast,tokens)

    | #Id: abort(ast,tokens)
    
    | #Num: #Some ast;
            ast <- { t. unfold t; ! t (astnum); #Num astnum; let! astnum tok1 };
            fwd tokens ast

    | #LamTok:
            wait tok1;
            tokens -> id; 
            case id of {
            | #Id :
                letc cont2 : OptionAST { factor(tokens,cont2) };
                case cont2 of {
                    | #Some :
                        cont2 -> astb;
                        unfold astb;
                        #Some ast; ast <- {
                            t. unfold t; ! t (astlam); 
                            #Lam astlam; astlam <- id; fwd! astlam astb 
                        };
                        fwd cont2 ast
                    | #None : wait cont2; #None ast; close ast
                }
            | #Lpar, #Rpar, #LamTok, #MulTok, 
              #PlusTok,#Error: wait id; abort(ast,tokens)
            | #Num : abort(ast,tokens)
           }

    | #PlusTok, #MulTok, #Error: wait tok1; abort(ast,tokens)

    }
};;


proc main()
{
    letc t0: tokStream { readTokens(t0) };
    letc ans: OptionAST { expr(t0,ans) };
    case ans of {
        | #None: println("Syntax Error!"); wait ans; ()
        | #Some: 
                ans->ast;
                letc ectx: env { mk_Empty(ectx) };
                ?ectx;
                letc v:value { evaltree(ast,v;ectx) };
                print_val(v);
                unfold ans;
                discard ans
    }
};;

